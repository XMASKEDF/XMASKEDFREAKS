{
  "name": "xmaskedfreaks-next",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "sync:game-assets": "node scripts/sync-game-assets.mjs",
    "predev": "npm run sync:game-assets",
    "dev": "node scripts/dev-server.mjs",
    "prebuild": "node scripts/assert-no-dev-server.mjs && npm run sync:game-assets && npm run check:i18n",
    "build": "NEXT_DIST_DIR=.next-production next build",
    "postbuild": "node scripts/check-style-build.mjs",
    "start": "NEXT_DIST_DIR=.next-production next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:games": "node --no-warnings --experimental-strip-types --test tests/game-mechanics.test.ts",
    "test:games-recovery": "node --no-warnings --experimental-strip-types --test tests/games-recovery.test.ts",
    "test:faq": "node --no-warnings --experimental-strip-types --test tests/faq-content.test.ts",
    "test:tips": "node --no-warnings --experimental-strip-types --test tests/tip-system.test.ts",
    "test:live-buttons": "node --no-warnings --import tsx --test tests/live-button-integrity.test.ts",
    "test:media": "node --no-warnings --experimental-strip-types --test tests/media-library.test.ts",
    "test:background": "node --no-warnings --experimental-strip-types --test tests/background-resize.test.ts",
    "test:audio-store": "node --no-warnings --experimental-strip-types --test tests/audio-store.test.ts",
    "test:purchase-flow": "node --no-warnings --experimental-strip-types --test tests/purchase-flow.test.ts",
    "test:commerce": "node --no-warnings --experimental-strip-types --test tests/commerce.test.ts",
    "test:printify-merch": "tsx --test tests/printify-coins-merch.test.ts",
    "test:printify-enterprise": "tsx --test tests/printify-enterprise.test.ts",
    "test:storefront": "node --no-warnings --experimental-strip-types --test tests/storefront-navigation.test.ts",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:styles": "node --test tests/style-integrity.test.mjs",
    "test:account": "node --no-warnings --experimental-strip-types --test tests/customer-account.test.ts",
    "test:prelaunch": "node --no-warnings --experimental-strip-types --test tests/prelaunch-readiness.test.ts",
    "test:admin-auth": "node --no-warnings --experimental-strip-types --test tests/admin-auth.test.ts",
    "test:reliability": "node --no-warnings --experimental-strip-types --test tests/reliability-center.test.ts",
    "test:hosted-payments": "node --no-warnings --experimental-strip-types --test tests/hosted-payments.test.ts",
    "test:security": "node --no-warnings --experimental-strip-types --test tests/security-hardening.test.ts",
    "test:backbone": "node --test tests/backbone.test.mjs",
    "test:infrastructure": "node --test tests/infrastructure-backbone.test.mjs",
    "test:admin-operationalization": "node --no-warnings --import tsx --test tests/admin-operationalization.test.ts",
    "test:remaining-integrations": "node --no-warnings --import tsx --test tests/remaining-integrations.test.ts",
    "test:shared-state": "node --no-warnings --import tsx --test tests/shared-state.test.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "backup:create": "node scripts/backup-create.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "release:check": "node scripts/production-verify.mjs --plan",
    "release:dry-run": "node scripts/production-verify.mjs --plan",
    "production:verify": "node scripts/production-verify.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "hls.js": "1.7.2",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
