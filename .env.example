# Public client settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase access
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# First administrator setup
ADMIN_SETUP_SECRET=replace-with-long-random-setup-secret

# Development-only authenticated Super Admin (never enable in production)
ADMIN_DEV_AUTH_ENABLED=false
ADMIN_DEV_EMAIL=owner@example.com
ADMIN_DEV_USERNAME=owner
ADMIN_DEV_PASSWORD_HASH=replace-with-bcrypt-hash-not-plaintext
ADMIN_DEV_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_DEVICE_SALT=replace-with-random-device-hash-salt
ADMIN_DEV_EMAIL_2FA=false
ADMIN_REAUTH_MAX_MINUTES=10

# AI support and intelligence control
OPENAI_API_KEY=replace-with-openai-api-key-or-leave-empty
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
CLAUDE_API_KEY=replace-with-claude-api-key-or-leave-empty
ANTHROPIC_API_KEY=replace-with-anthropic-api-key-or-leave-empty
CLAUDE_CONTROL_MODEL=claude-3-5-sonnet-latest

# OBS / live-status detection
OBS_LIVE=false
OBS_STREAM_ACTIVE=false
OBS_STATUS_ENDPOINT=https://your-obs-status-endpoint.example/status
NOTIFICATION_SANDBOX_STREAM_ACTIVE=false
VIEWER_DISPLAY_MULTIPLIER=10
LIVE_BROADCAST_SESSION_ID=

# Offline redirect destinations and deterministic routing
FANSLY_URL=https://fansly.com/your-profile
CLIPS4SALE_URL=https://www.clips4sale.com/studio/your-studio-id/your-studio
REDIRECT_OVERRIDE_URL=
REDIRECT_MANUAL_DESTINATION=automatic
REDIRECT_CLIPS_PERCENT=60
REDIRECT_OFFLINE_BLOCKS=[{"id":"daily-offline","label":"Daily offline block","start":"00:00","end":"23:59","destination":"split"}]

# Provider-hosted coin checkout (server-only)
# Production default is disabled. Test mode is development-only.
APP_URL=http://localhost:3000
PAYMENT_PROVIDER=disabled
PAYMENT_DISABLED_CUSTOMER_MODE=setup_in_progress
PAYMENT_TEST_SECRET=replace-with-at-least-24-random-development-characters
# Segpay and CCBill remain inactive until official approved integration guides,
# callback rules, and merchant credentials are reviewed by the site owner.
SEGPAY_MERCHANT_ID=
SEGPAY_PRODUCT_CODE=
SEGPAY_HOSTED_CHECKOUT_URL=
SEGPAY_POSTBACK_SECRET=
SEGPAY_RETURN_URL=
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUBACCOUNT_NUMBER=
CCBILL_FLEXFORM_ID=
CCBILL_API_BASE_URL=
CCBILL_WEBHOOK_SECRET=
CCBILL_RETURN_URL=

# Geo/security privacy salt
GEO_IP_HASH_SALT=replace-with-long-random-geo-hash-salt

# Support escalation and admin notifications
SUPPORT_ESCALATION_ENDPOINT=
ADMIN_SUPPORT_EMAIL=
DEPOSIT_ALERT_EMAIL=

# Middleware security controls
SECURITY_WHITELIST_IPS=
SECURITY_BLACKLIST_IPS=
SECURITY_BLACKLIST_COUNTRIES=
SECURITY_BLACKLIST_USER_AGENTS=
BOT_PROTECTION_SENSITIVITY=balanced
BOT_DETECTION_ENABLED=true
BOT_DETECTION_LEVEL=easy
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_MODE=disabled
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
TRUSTED_PROXY_MODE=direct

# Email delivery: server-only, disabled by default. Resend requires a verified sender/domain.
EMAIL_PROVIDER=disabled
EMAIL_MODE=disabled
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Test mode may deliver only to this comma-separated, explicitly approved allowlist.
EMAIL_TEST_RECIPIENTS=
# Optional compatibility adapter; use only with EMAIL_PROVIDER=custom-http.
EMAIL_API_URL=
EMAIL_API_KEY=

# Pre-launch operations: server-only unless marked public-safe
CRON_SECRET=replace-with-long-random-scheduled-job-secret
ANALYTICS_HASH_SALT=replace-with-long-random-analytics-salt
ANALYTICS_RETENTION_DAYS=180
POLICY_ACCEPTANCE_SALT=replace-with-long-random-policy-salt
SIGNED_DOWNLOAD_SECRET=replace-with-long-random-download-secret
ERROR_MONITOR_DSN=
ERROR_REPORTING_PROVIDER=NONE
CDN_PUBLIC_BASE_URL=

# Reliability and incident evidence
RELIABILITY_IP_SALT=replace-with-long-random-reliability-hash-salt
DEPLOYMENT_VERSION=local
RELIABILITY_APP_ERROR_RETENTION_DAYS=90
RELIABILITY_BROWSER_ERROR_RETENTION_DAYS=30
RELIABILITY_PERFORMANCE_RETENTION_DAYS=30
RELIABILITY_SECURITY_RETENTION_DAYS=365
RELIABILITY_FINANCIAL_RETENTION_DAYS=2555

# Coins-only physical merchandise fulfillment (server-only)
# The application enforces 1 coin = 50 USD cents in lib/commerce/coins.ts.
PHYSICAL_MERCH_PAYMENT_MODE=coins_only
PRINTIFY_INTEGRATION_MODE=disabled
PRINTIFY_API_TOKEN=replace-with-server-only-printify-token
PRINTIFY_SHOP_ID=replace-with-printify-shop-id
PRINTIFY_WEBHOOK_SECRET=replace-with-printify-webhook-signing-secret

# Tax quote adapter for physical merchandise (server-only)
TAX_API_URL=https://your-approved-tax-provider.example/quote
TAX_API_KEY=replace-with-server-only-tax-provider-key

# Provider-neutral infrastructure backbone
XMF_ENVIRONMENT=LOCAL
STORAGE_PROVIDER=LOCAL
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
# Supabase Storage buckets. Keep paid/private buckets non-public.
PUBLIC_MEDIA_BUCKET=public-media
PRIVATE_MEDIA_BUCKET=media
PRIVATE_DIGITAL_BUCKET=private-digital
PROCESSING_MEDIA_BUCKET=media-processing
STORAGE_SIGNED_URL_TTL_SECONDS=300
CDN_PROVIDER=NONE
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
QUEUE_PROVIDER=LOCAL
# Cache is process-local for development. Production multi-instance deployments
# require REDIS_COMPATIBLE plus the server-only endpoint and token below.
CACHE_PROVIDER=LOCAL
# Server-only Redis-compatible REST endpoint/token; never use NEXT_PUBLIC_* names.
REDIS_URL=
REDIS_REST_URL=
REDIS_TOKEN=
EVENT_BUS_PROVIDER=LOCAL
STREAMING_PROVIDER=NONE
STREAM_HEALTH_URL=
STREAM_PLAYBACK_BASE_URL=
BACKUP_PROVIDER=NONE
BACKUP_STATUS_URL=
BACKUP_RESTORE_TEST_URL=
BACKUP_PROVIDER_TOKEN=
BACKUP_PITR_STATUS=NOT CONFIGURED
BACKUP_LAST_SUCCESS_AT=
BACKUP_LAST_RESTORE_TEST_AT=
EXTERNAL_MONITOR_PROVIDER=NONE
EXTERNAL_MONITOR_URL=
EXTERNAL_MONITOR_TOKEN=
MONITORING_PROVIDER=NONE
ALERT_PROVIDER=NONE
ALERT_COOLDOWN_SECONDS=300
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
WAF_PROVIDER=cloudflare
WAF_MODE=disabled
UPLOAD_SCANNER_URL=
UPLOAD_SCANNER_TOKEN=
UPLOAD_SCANNER_MODE=url
MEDIA_PROCESSOR_PROVIDER=local
MEDIA_WORKER_URL=
MEDIA_WORKER_SECRET=
FFMPEG_PATH=
FFPROBE_PATH=
DEPLOYMENT_HEALTH_URL=
DEPLOYMENT_ROLLBACK_URL=
DEPLOYMENT_PROVIDER_TOKEN=
DEPLOYMENT_TIME=
PREVIOUS_RELEASE_VERSION=

# Optional infrastructure rollout flags. These are server-side defaults only;
# production requires a durable, audited feature-flag provider before enabling.
XMF_FLAG_NEW_CHECKOUT=OFF
XMF_FLAG_NEW_STREAM_PLAYER=OFF
XMF_FLAG_NEW_GAME_ENGINE=OFF
XMF_FLAG_NEW_STORAGE=OFF
XMF_FLAG_NEW_PAYMENT_PROVIDER=OFF
